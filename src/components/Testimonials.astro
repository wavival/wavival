---
import Icons from './Icons.astro';
---

<section class="testimonials">
  <div class="testimonials-container">
    <div class="section-header">
      <h2>Lo que dicen nuestros clientes</h2>
      <p>Historias reales de clientes satisfechos</p>
    </div>

    <div class="testimonials-grid">
      <!-- Testimonial 1 -->
      <div class="testimonial-card">
        <div class="stars">
          {[...Array(5)].map(() => (
            <Icons name="star" size={18} />
          ))}
        </div>

        <p class="quote">
          "La sesión fue increíble. El fotógrafo captó cada momento especial de nuestro evento. Nos encantó la edición y la calidad de las fotos. ¡Totalmente recomendado!"
        </p>

        <div class="reviewer">
          <div class="avatar">AJ</div>
          <div class="reviewer-info">
            <h4>Alejandra Jiménez</h4>
            <p>Boda - Junio 2024</p>
          </div>
        </div>
      </div>

      <!-- Testimonial 2 -->
