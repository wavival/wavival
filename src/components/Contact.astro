---
import Icons from './Icons.astro';
---

<section id="contacto" class="contact">
  <div class="contact-container">
    <div class="section-header">
      <h2>Contacta con nosotros</h2>
      <p>¿Listo para capturar tus momentos especiales?</p>
    </div>

    <div class="contact-content">
      <!-- Formulario -->
      <div class="form-section">
        <form class="contact-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="Tu nombre"
              aria-label="Nombre completo"
            />
          </div>

          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="tu@email.com"
              aria-label="Correo electrónico"
            />
          </div>

          <div class="form-group">
            <label for="phone">Teléfono (opcional)</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+57 300 000 0000"
              aria-label="Teléfono"
            />
          </div>

          <div class="form-group">
            <label for="service">Tipo de servicio</label>
            <select id="service" name="service" required aria-label="Tipo de servicio">
              <option value="">Selecciona un servicio</option>
              <option value="basic">Sesión Básica</option>
              <option value="pro">Sesión Pro</option>
              <option value="event">Evento Completo</option>
              <option value="custom">Consulta personalizada</option>
            </select>
          </div>

          <div class="form-group">
            <label for="date">Fecha del evento (opcional)</label>
            <input
              type="date"
              id="date"
              name="date"
              aria-label="Fecha del evento"
            />
          </div>

          <div class="form-group">
            <label for="message">Mensaje</label>
            <textarea
              id="message"
              name="message"
              required
              placeholder="Cuéntanos sobre tu evento..."
              rows="5"
              aria-label="Mensaje"
            ></textarea>
          </div>

          <button type="submit" class="btn btn-primary">Enviar solicitud</button>
        </form>
      </div>

      <!-- Información de contacto -->
      <div class="info-section">
        <div class="info-box">
          <div class="info-header">
            <Icons name="mail" size={28} />
            <h3>Email</h3>
          </div>
          <p>
            <a href="mailto:contacto@fotografiaprof.com">contacto@fotografiaprof.com</a>
          </p>
          <p class="small">Responderemos en máximo 24 horas</p>
        </div>

        <div class="info-box">
          <div class="info-header">
            <Icons name="phone" size={28} />
            <h3>Teléfono</h3>
          </div>
          <p>
            <a href="tel:+573001234567">+57 300 123 4567</a>
          </p>
          <p class="small">Lun-Vie: 9:00 AM - 6:00 PM</p>
        </div>

        <div class="info-box">
          <div class="info-header">
            <Icons name="message" size={28} />
            <h3>WhatsApp</h3>
          </div>
          <p>
            <a href="https://wa.me/573001234567" target="_blank" rel="noopener noreferrer">
              +57 300 123 4567
            </a>
          </p>
          <p class="small">Disponible para consultas rápidas</p>
        </div>

        <!-- Redes sociales -->
        <div class="social-box">
          <h3>Síguenos</h3>
          <div class="social-links">
            <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <Icons name="instagram" size={28} />
            </a>
            <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <Icons name="facebook" size={28} />
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <Icons name="linkedin" size={28} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 6rem 2rem;
    background-color: var(--color-white);
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--color-primary-700);
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--color-dark-700);
  }

  .contact-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  /* Formulario */
  .form-section {
    display: flex;
    flex-direction: column;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    color: var(--color-dark-900);
    font-size: 0.95rem;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.875rem 1rem;
    border: 2px solid var(--color-gray-300);
    border-radius: 8px;
    font-size: 1rem;
    transition: var(--transition);
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary-600);
    box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.1);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: var(--transition);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-accent-600));
    color: var(--color-white);
    box-shadow: 0 10px 30px rgba(168, 85, 247, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(168, 85, 247, 0.4);
  }

  /* Información de contacto */
  .info-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .info-box {
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-accent-50));
    border: 2px solid var(--color-primary-100);
    border-radius: 12px;
    padding: 2rem;
    transition: var(--transition);
  }

  .info-box:hover {
    border-color: var(--color-primary-600);
    box-shadow: 0 8px 25px rgba(168, 85, 247, 0.12);
  }

  .info-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .info-header svg {
    color: var(--color-primary-600);
    flex-shrink: 0;
  }

  .info-header h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-dark-900);
  }

  .info-box p {
    margin: 0.5rem 0;
  }

  .info-box a {
    color: var(--color-primary-600);
    font-weight: 600;
    text-decoration: none;
  }

  .info-box a:hover {
    text-decoration: underline;
  }

  .small {
    font-size: 0.85rem;
    color: var(--color-dark-700);
  }

  .social-box {
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-accent-50));
    border: 2px solid var(--color-primary-100);
    border-radius: 12px;
    padding: 2rem;
  }

  .social-box h3 {
    margin: 0 0 1.5rem 0;
    font-size: 1.25rem;
    color: var(--color-dark-900);
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-primary-600);
    transition: var(--transition);
    border: 2px solid var(--color-primary-200);
  }

  .social-links a:hover {
    background: var(--color-primary-600);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .contact {
      padding: 3rem 1rem;
    }

    .contact-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-header h2 {
      font-size: 1.75rem;
    }
  }
</style>
