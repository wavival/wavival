---
import Icons from './Icons.astro';
---

<section id="servicios" class="services">
  <div class="services-container">
    <div class="section-header">
      <h2>Nuestros Servicios</h2>
      <p>Planes diseñados para cada ocasión especial</p>
    </div>

    <div class="services-grid">
      <!-- Plan Sesión Básica -->
      <div class="service-card">
        <div class="card-header">
          <Icons name="camera" size={40} class="icon" />
          <h3>Sesión Básica</h3>
        </div>

        <div class="price">
          <span class="amount">$150</span>
          <span class="period">/sesión</span>
        </div>

        <ul class="features">
          <li>
            <Icons name="check" size={20} />
            <span>2 horas de cobertura</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>50-75 fotos editadas</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Galería digital</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Descarga de alta resolución</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Revisiones ilimitadas</span>
          </li>
        </ul>

        <button class="btn btn-outline">Consultar disponibilidad</button>
      </div>

      <!-- Plan Sesión Pro -->
      <div class="service-card featured">
        <div class="badge">Más popular</div>

        <div class="card-header">
          <Icons name="camera" size={40} class="icon" />
          <h3>Sesión Pro</h3>
        </div>

        <div class="price">
          <span class="amount">$300</span>
          <span class="period">/sesión</span>
        </div>

        <ul class="features">
          <li>
            <Icons name="check" size={20} />
            <span>4 horas de cobertura</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>150-200 fotos editadas</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Galería digital premium</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Descarga 4K + imprimible</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Álbum digital interactivo</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Video highlights (1 min)</span>
          </li>
        </ul>

        <button class="btn btn-primary">Reservar ahora</button>
      </div>

      <!-- Plan Evento Completo -->
      <div class="service-card">
        <div class="card-header">
          <Icons name="camera" size={40} class="icon" />
          <h3>Evento Completo</h3>
        </div>

        <div class="price">
          <span class="amount">$600+</span>
          <span class="period">personalizado</span>
        </div>

        <ul class="features">
          <li>
            <Icons name="check" size={20} />
            <span>8+ horas de cobertura</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>300+ fotos editadas</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Segundo fotógrafo opcional</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Cinematic video (3-5 min)</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Álbum fotográfico impreso</span>
          </li>
          <li>
            <Icons name="check" size={20} />
            <span>Sesión de fotos adicional</span>
          </li>
        </ul>

        <button class="btn btn-outline">Cotizar evento</button>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 2rem;
    background-color: var(--color-white);
  }

  .services-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    color: var(--color-primary-700);
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.125rem;
    color: var(--color-dark-700);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .service-card {
    background: var(--color-white);
    border: 2px solid var(--color-gray-300);
    border-radius: 16px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    transition: var(--transition);
    position: relative;
  }

  .service-card:hover {
    border-color: var(--color-primary-600);
    box-shadow: 0 10px 40px rgba(168, 85, 247, 0.1);
    transform: translateY(-4px);
  }

  .service-card.featured {
    border-color: var(--color-primary-600);
    background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-50) 100%);
    transform: scale(1.05);
  }

  .badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-accent-600));
    color: var(--color-white);
    padding: 0.5rem 1.5rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .icon {
    color: var(--color-primary-600);
    flex-shrink: 0;
  }

  .card-header h3 {
    font-size: 1.5rem;
    color: var(--color-dark-900);
    margin: 0;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .amount {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-primary-600);
  }

  .period {
    color: var(--color-dark-700);
    font-size: 0.95rem;
  }

  .features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-dark-700);
  }

  .features svg {
    color: var(--color-primary-600);
    flex-shrink: 0;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 1rem;
    border: none;
    cursor: pointer;
    transition: var(--transition);
    width: 100%;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-primary-600), var(--color-accent-600));
    color: var(--color-white);
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(168, 85, 247, 0.3);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-primary-600);
    border: 2px solid var(--color-primary-600);
  }

  .btn-outline:hover {
    background: var(--color-primary-600);
    color: var(--color-white);
  }

  @media (max-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-card.featured {
      transform: scale(1);
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .services {
      padding: 3rem 1rem;
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card.featured {
      transform: scale(1);
    }

    .section-header h2 {
      font-size: 1.75rem;
    }
  }
</style>
