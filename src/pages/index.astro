---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
---

<BaseLayout
  title="Fotografía Profesional | Servicios de Foto y Video"
  description="Servicios profesionales de fotografía para bodas, eventos, sesiones familiares y más. Captura tus momentos especiales con calidad garantizada."
>
  <Hero />
  <Services />
  <Testimonials />
  <Contact />

  <style is:global>
    html {
      scroll-behavior: smooth;
    }

    body {
      overflow-x: hidden;
    }
  </style>
</BaseLayout>
